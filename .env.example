# Porta HTTP. Opcional; o padrão local é 3000.
PORT=3000

# Ambiente de execução. Em produção, JWT_SECRET passa a ser obrigatório.
NODE_ENV=development

# Chave longa, aleatória e privada para assinatura dos tokens JWT.
JWT_SECRET="substitua-por-uma-chave-segura"

# Diretório persistente do banco JSON. Opcional; o padrão é ./data.
DATA_DIR="./data"
