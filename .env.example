# Porta HTTP. Opcional; o padrão local é 3000.
PORT=3000

# Ambiente de execução. Em produção, JWT_SECRET passa a ser obrigatório.
NODE_ENV=development

# Chave longa, aleatória e privada para assinatura dos tokens JWT.
JWT_SECRET="substitua-por-uma-chave-segura"

# Connection string PostgreSQL fornecida pelo Supabase.
# Use a conexão direta para migrations e, no runtime, a URL do pooler quando necessário.
DATABASE_URL="postgresql://postgres:SENHA@HOST:5432/postgres"

# Supabase exige SSL. Mantenha a validação habilitada sempre que possível.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Ajuste conforme o limite do plano/pooler do Supabase.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Supabase Storage para PDFs/DOCX do escopo dos projetos.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-somente-no-backend"
SUPABASE_STORAGE_BUCKET="project-resources"

# Ferramentas explícitas de migração; não são usadas automaticamente no startup.
LEGACY_JSON_PATH="./data/app_database.json"
ALLOW_DEMO_SEED=false
