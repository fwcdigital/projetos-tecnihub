{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "server.production.ts",
    "server/**/*.ts"
  ]
}
